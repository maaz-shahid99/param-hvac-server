# --- Discovery server email/alert config -------------------------------------
# Copy to .env and `set -a; . ./.env; set +a` before launching, or export these.

SITE_NAME="Rack room A"

# Presence thresholds
HEARTBEAT_TIMEOUT=30          # sensor silent this long => assume offline
WATCHDOG_INTERVAL=5
LONG_POLL_TIMEOUT=25

# SMTP (leave SMTP_HOST empty to just log the alert instead of emailing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password   # Gmail: use an App Password, not your login
ALERT_FROM=you@gmail.com
ALERT_TO=ops1@example.com,ops2@example.com

# --- Display / forwarding node ----------------------------------------------
DISCOVERY_URL=http://your-cloud-host:8000
NODE_PORT=8001
NUM_BOXES=12
DEFAULT_PROBES=8
