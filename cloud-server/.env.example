# ---------------------------------------------------------------------------
# Cloud Server configuration. Copy to ".env" (or export these) before running.
# Every value has a safe local-dev default, so the service runs with NONE of
# these set — it uses SQLite and logs alerts instead of sending them.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local dev (default): a SQLite file next to the code.
#   sqlite:///cloud.db
# Production on AWS RDS Postgres:
#   postgresql+psycopg://USER:PASS@your-db.xxxx.rds.amazonaws.com:5432/hvac
DATABASE_URL=sqlite:///cloud.db

# --- Auth ------------------------------------------------------------------
# Secret used to sign JWTs. MUST be set to a long random value in production.
JWT_SECRET=dev-insecure-change-me
JWT_EXPIRE_HOURS=720
# Bootstrap token required to call POST /v1/auth/register (creates a tenant +
# admin user). Leave empty to disable self-registration entirely in prod.
BOOTSTRAP_TOKEN=dev-bootstrap

# Password reset via emailed 6-digit code (POST /v1/auth/forgot -> /v1/auth/reset).
# Without SES configured (below), the code is logged instead of emailed.
OTP_TTL_S=600            # reset code lifetime in seconds (10 min)
OTP_MAX_ATTEMPTS=5       # wrong-code guesses before the code is invalidated
MIN_PASSWORD_LEN=6       # minimum length enforced on the new password

# --- Alert thresholds (tenant defaults; overridable per rack/port via API) --
DEFAULT_HIGH_C=40        # high-temperature alert limit (deg C)
DEFAULT_DELTA_C=20       # max exhaust-minus-intake delta (deg C)
HYSTERESIS_C=3           # must cool this far below the limit before clearing
ALERT_COOLDOWN_S=900     # min seconds between re-notifications for one open alert
STALE_AFTER_S=180        # a mapped sensor silent this long -> stale alert
WATCHDOG_INTERVAL_S=30   # how often the stale-sensor watchdog runs

# --- Email/SMS delivery (leave all blank to just log) ----------------------
# Order: SES (if SES_FROM set) -> SMTP (if SMTP_HOST set) -> log only.
#
# AWS path:
AWS_REGION=us-east-1
SES_FROM=                 # verified SES sender; empty => fall through to SMTP/log
SNS_SMS_ENABLED=0         # SNS SMS; empty/0 => log. AWS creds via env / IAM role
#
# Local / on-prem path (no AWS) — send real email through any SMTP server:
#   Gmail:      SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  (use an App Password)
#   Office 365: SMTP_HOST=smtp.office365.com SMTP_PORT=587
#   LAN relay:  SMTP_HOST=<relay-ip> SMTP_PORT=25 SMTP_STARTTLS=0 (no login)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=1
MAIL_FROM=                # from-address; defaults to SES_FROM or SMTP_USER
#
# SMS via Twilio (local/on-prem alternative to SNS). Order: SNS -> Twilio -> log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=              # your Twilio number in E.164, e.g. +15551234567

# --- Hardening -------------------------------------------------------------
# dev (default) = no checks. onprem = LAN appliance (enforce strong secrets,
# allow SQLite/HTTP). production = cloud (also require Postgres + CORS allowlist).
ENV=dev
# Explicit CORS allowlist in prod (comma-separated). '*' is rejected in prod.
CORS_ORIGINS=*
# Per-IP rate limit on auth endpoints (login/register/forgot/reset).
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_S=60

# --- Manufacturer field-support + firmware OTA -----------------------------
# Shared secret for the field-service console (/v1/support/* reads + firmware
# publish + canary/promote). BLANK => the whole support + OTA-publish API is
# DISABLED (404). Set a STRONG random value (>= 24 chars) to enable remote
# diagnostics + OTA over the LAN. Treat like a password; rotate-able.
SUPPORT_TOKEN=
# Where published firmware images + manifest.json live (served at /firmware/*).
# Defaults to ./firmware next to the code.
FIRMWARE_DIR=

# --- mDNS / Bonjour discovery (hvac-appliance.local) -----------------------
# Advertise the appliance by name on the LAN so the app/console/gateway connect
# to http://<MDNS_NAME>.local:PORT instead of a hard IP. Needs the optional
# `zeroconf` package; a missing dep or failure is a no-op (connect by IP).
# Turn off in cloud/prod (no LAN). 1=on (default), 0=off.
MDNS_ENABLED=1
MDNS_NAME=hvac-appliance

# --- Discovery service (merged in at /discovery) ----------------------------
# discovery_routes.py serves the LAN rendezvous + presence watchdog on this same
# port under /discovery/*, so a gateway only needs the cloud URL (it derives
# <cloud_url>/discovery itself). These endpoints are UNAUTHENTICATED, matching the
# old standalone :8000 service — keep this port LAN-only, or firewall /discovery/*,
# if the appliance is internet-facing.
# Its own sqlite file (separate from DATABASE_URL); relative to the working dir.
DISCOVERY_DB=discovery.db
# A sensor counts as "gone" after this many seconds without a heartbeat, and the
# watchdog re-checks presence every WATCHDOG_INTERVAL seconds.
HEARTBEAT_TIMEOUT=30
WATCHDOG_INTERVAL=5
LONG_POLL_TIMEOUT=25
# Site-offline email alerts (reuses SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS above).
# Blank ALERT_TO => transitions are logged only, never emailed.
ALERT_TO=
ALERT_FROM=
SITE_NAME=HVAC site

# Legacy discovery paths at the root (deployed-firmware compatibility).
# Firmware provisioned BEFORE discovery was merged appends its paths to the bare
# URL it was given (POST /register/sensor, GET /discover) — the shape the old
# standalone :8000 service served. With this on, those routes are served at the
# root as well as under /discovery, so an already-deployed fleet keeps reporting
# without a reflash. Set to 0 once every unit runs firmware that derives
# <cloud>/discovery itself. 1=on (default), 0=off.
DISCOVERY_LEGACY_ROOT=1

# --- Server ----------------------------------------------------------------
PORT=8002
